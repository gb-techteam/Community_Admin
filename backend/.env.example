PORT=5000
# Listen on all interfaces so other devices can reach this machine
HOST=0.0.0.0

# PostgreSQL
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# Super Admin
SUPER_ADMIN_ID=superadmin
SUPER_ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# Public SuperKandle subscribe app
PUBLIC_APP_URL=https://superkandle.greenbonds.ae
CORS_ORIGINS=https://superkandle.greenbonds.ae

# Momentum / TraderConnect
TRADER_CONNECT_API_BASE=https://traderconnectapi.greenbondsacademy.com/api
TRADER_CONNECT_API_KEY=your-external-app-api-key
# Alias also accepted:
# EXTERNAL_APP_API_KEY=your-external-app-api-key

# TradingView invite/remove automation
TRADINGVIEW_QUEUE_KEY=change-me-tradingview-queue-key

# WhatsApp Cloud API (invitation shared, expiry, activation)
# WHATSAPP_TOKEN=EAAB...
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_COUNTRY_CODE=91
